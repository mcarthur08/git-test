rules_version = '2';
// NT70 Quest security rules. Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isLeader() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    // Username accounts sign in as <username>@users.nt70-quest.web.app (no real email).
    function isUser(u) { return signedIn() && request.auth.token.email == u + '@users.nt70-quest.web.app'; }
    function myUsername() { return request.auth.token.email.split('@')[0]; }
    // A leader-approved transfer lets the new account remove the character it took over.
    function claimedBy(uid) {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.matches('.*@users[.]nt70-quest[.]web[.]app')
        && exists(/databases/$(database)/documents/transfers/$(myUsername()))
        && get(/databases/$(database)/documents/transfers/$(myUsername())).data.from == uid;
    }
    function validPlayer() {
      let d = request.resource.data;
      return d.keys().hasOnly(['alias', 'gender', 'team', 'look', 'done', 'quiz', 'createdAt', 'updatedAt'])
        && (!('quiz' in d) || (d.quiz is map && d.quiz.size() <= 70))
        && d.alias is string && d.alias.size() <= 40
        && d.team is string && d.team.size() <= 30
        && d.look is map && d.done is map && d.done.size() <= 70;
    }

    // Each person writes only their own player; everyone signed in sees the leaderboard.
    match /players/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && validPlayer();
      // Players update themselves; leaders may only move someone to another tribe.
      allow update: if signedIn() && ((request.auth.uid == uid && validPlayer())
        || (isLeader() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['team'])));
      allow delete: if signedIn() && (request.auth.uid == uid || isLeader() || claimedBy(uid));
    }

    // Group settings (start date, tribe names): public so the welcome page can show the dates; only leaders write.
    match /config/{doc} {
      allow read: if true;
      allow write: if isLeader();
    }

    // Cheers: one per sender per person (id "<to>_<from>"); only the sender writes it.
    match /cheers/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.from == request.auth.uid
        && id == request.resource.data.to + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['to', 'from', 'kind', 'at'])
        && request.resource.data.kind in ['pray', 'fire'];
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || isLeader());
    }

    // Victory Moment discussion: short replies; authors and leaders can delete.
    match /replies/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['week', 'uid', 'text', 'at'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 280
        && request.resource.data.week is int && request.resource.data.week >= 1 && request.resource.data.week <= 10;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isLeader());
    }

    // Group chat: anyone signed in posts (500 characters). Leaders pin and mark questions answered;
    // the person who asked can mark their own question answered. Authors and leaders delete.
    match /messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'text', 'q', 'at'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.q is bool && request.resource.data.at is string;
      allow update: if signedIn() && (
        (isLeader() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answered', 'pinned']))
        || (resource.data.uid == request.auth.uid && resource.data.q == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answered'])))
        && (!('answered' in request.resource.data) || request.resource.data.answered is bool)
        && (!('pinned' in request.resource.data) || request.resource.data.pinned is bool);
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isLeader());
    }

    // Chat reports: one per person per message (id "<message>_<reporter>"); only leaders read them.
    match /reports/{id} {
      allow read, delete: if isLeader();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.msg + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['msg', 'uid', 'at']);
    }

    // Reading bookmark: the verse each person stopped at in the in-app reader. Only they read or write it.
    match /bookmarks/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['day', 'ci', 'v', 'at', 'manual'])
        && request.resource.data.day is int && request.resource.data.day >= 1 && request.resource.data.day <= 70
        && request.resource.data.ci is int && request.resource.data.ci >= 0 && request.resource.data.ci < 10
        && request.resource.data.v is int && request.resource.data.v >= 1 && request.resource.data.v <= 200
        && request.resource.data.at is string && request.resource.data.manual is bool;
    }

    // Account recovery: a leader points an old character at a new username; that username claims it.
    match /transfers/{u} {
      allow read: if isLeader() || isUser(u);
      allow create, update: if isLeader();
      allow delete: if isLeader() || isUser(u);
    }

    // Leaders are added by hand in the Firebase console (see SETUP.md).
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
